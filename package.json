{
  "name": "tledger",
  "version": "0.4.0",
  "description": "A local-only terminal dashboard for Codex token usage",
  "license": "MIT",
  "keywords": [
    "codex",
    "cli",
    "terminal",
    "tokens",
    "usage",
    "privacy"
  ],
  "homepage": "https://github.com/jskoiz/token-ledger#readme",
  "bugs": {
    "url": "https://github.com/jskoiz/token-ledger/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jskoiz/token-ledger.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "bin",
    "lib",
    "docs",
    "README.md"
  ],
  "bin": {
    "tledger": "bin/token-ledger.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:stress": "node --test tests/stress/*.test.mjs",
    "test:all": "npm test && npm run test:stress",
    "cli:test": "node --test tests/cli.smoke.test.mjs",
    "lint": "eslint .",
    "usage:snapshot": "node lib/token-ledger-importer.mjs --output outputs/token-ledger-snapshot-v3.json.gz",
    "usage:day": "node bin/token-ledger.mjs day",
    "usage:week": "node bin/token-ledger.mjs week",
    "verify:release": "node tools/verify-release.mjs",
    "prepublishOnly": "npm test && npm run verify:release",
    "benchmark:refresh": "node tools/benchmark-importer.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4"
  },
  "type": "module",
  "dependencies": {
    "sharp": "^0.35.3"
  }
}
